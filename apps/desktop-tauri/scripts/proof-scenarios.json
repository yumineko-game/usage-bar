        { "click": { "selector": "button", "label": "Automatic", "near": "Cookie source" } },
        { "expectCall": { "cmd": "set_provider_cookie_source", "args": { "providerId": "claudeplatform", "source": "auto" } } },
        { "expectSelector": ".provider-detail-cookie-source .provider-detail-segmented__option.is-active" },
        { "screenshot": "settings-claudeplatform-cookie-source" }
