    {
      "name": "settings-claude-token-account-edit",
      "query": "window=settings&tab=providers:claude&fixture=default&theme=dark",
      "size": [
        880,
        760
      ],
      "steps": [
        {
          "click": {
            "selector": "summary",
            "label": "Token accounts1/2"
          }
        },
        {
          "expectOrder": {
            "selector": ".token-accounts-card > .credential-card__header > .credential-card__info > strong",
            "texts": [
              "Work",
              "Personal"
            ]
          }
        },
        {
          "click": {
            "selector": "button",
            "label": "Edit",
            "near": "Personal"
          }
        },
        {
          "expectSelector": ".token-accounts-edit input[type=\"password\"]"
        },
        {
          "type": {
            "selector": ".token-accounts-edit input",
            "label": "Label (e.g. Work, Personal)…",
            "text": "Personal (renamed)"
          }
        },
        {
          "screenshot": "settings-claude-token-account-edit"
        },
        {
          "click": {
            "selector": "button",
            "label": "Save",
            "near": "Leave blank to keep the saved credential."
          }
        },
        {
          "expectCall": {
            "cmd": "update_token_account",
            "args": {
              "providerId": "claude",
              "accountId": "00000000-0000-4000-8000-00000000c1a2",
              "label": "Personal (renamed)",
              "token": null
            }
          }
        },
        {
          "expectNoText": "Leave blank to keep the saved credential."
        },
        {
          "expectOrder": {
            "selector": ".token-accounts-card > .credential-card__header > .credential-card__info > strong",
            "texts": [
              "Work",
              "Personal (renamed)"
            ]
          }
        },
        {
          "screenshot": "settings-claude-token-account-edit"
        }
      ]
    }
  ]
