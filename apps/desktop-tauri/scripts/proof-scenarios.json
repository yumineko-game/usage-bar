{
  "scenarios": [
    {
      "name": "flyout-japanese-dark",
      "query": "window=flyout&fixture=japanese-quotas&theme=dark",
      "size": [310, 520],
      "steps": [
        { "expectText": ["5時間", "1週間", "更新", "設定"] },
        { "expectNoText": ["Session", "Weekly", "Cost", "Usage & Spend", "Conversations", "Resets in"] },
        { "expectSelector": ".menu-metric__title + .menu-metric__gauge[title]:has(.menu-metric__gauge-pace:not([title])) + .menu-metric__reset" },
        { "expectSelector": ".menu-surface--tray:not(:has(.menu-metric__progress-workday, .menu-metric__progress-warning))" },
        { "expectStyle": { "selector": ".menu-surface--tray", "property": "color-scheme", "value": "dark" } },
        { "expectStyle": { "selector": ".menu-surface--tray", "property": "border-radius", "value": "0px" } },
        { "expectStyle": { "selector": ".menu-metric__gauge", "property": "height", "value": "18px" } },
        { "expectNoOverflow": ".menu-metric__reset" },
        { "screenshot": "flyout-japanese-dark", "clip": "panel" }
      ]
    },
    {
      "name": "flyout-japanese-auto-light",
      "query": "window=flyout&fixture=japanese-quotas&theme=auto&system=light",
