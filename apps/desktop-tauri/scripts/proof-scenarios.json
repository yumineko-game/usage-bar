      "name": "settings-claudeplatform-cookie-source",
      "query": "window=settings&tab=providers:claudeplatform&fixture=claudeplatform&theme=dark",
      "size": [880, 620],
      "steps": [
        { "expectText": ["Claude Platform", "Cookie source", "Automatic", "Manual", "Off"] },
